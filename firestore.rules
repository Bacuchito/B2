rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures:
    //
    // Collection: /rooms/{roomId}/schreiben/{taskId}
    // Document ID: {taskId} (string, 1-64 chars: alphanumeric, '-', '_')
    // Parent Path: /rooms/{roomId} (roomId: string, 1-64 chars: alphanumeric, '-', '_')
    //
    // Fields for /rooms/{roomId}/schreiben/{taskId}:
    //   - sergio_text: string (optional, 0 to 10000 chars) - Sergio's writing draft
    //   - sergio_words: int (optional, 0 to 2000) - Sergio's word count
    //   - sergio_eval: map (optional, max 50 keys) - Sergio's LLM evaluation report
    //   - sergio_updated_at: int or timestamp (optional, >= 0 if int) - Sergio's last update
    //   - diana_text: string (optional, 0 to 10000 chars) - Diana's writing draft
    //   - diana_words: int (optional, 0 to 2000) - Diana's word count
    //   - diana_eval: map (optional, max 50 keys) - Diana's LLM evaluation report
    //   - diana_updated_at: int or timestamp (optional, >= 0 if int) - Diana's last update
    //
    // Optional Parent Document /rooms/{roomId}:
    //   - created_at: int or timestamp (optional, >= 0 if int) - Room creation timestamp
    //   - updated_at: int or timestamp (optional, >= 0 if int) - Room heartbeat/update timestamp
    //
    // Access Pattern & Business Logic:
    //   - Shared link access: Explicitly requested "Acceso libre sin contraseña
    //     (solo compartiendo el enlace directo entre vosotros)" for Sergio & Diana.
    //   - NO AUTHENTICATION: the room id is a shared secret, not an access control.
    //     Anyone who knows it can read and write both users' drafts. Treat the room
    //     id like a password (long and random) and do not publish it. Real per-user
    //     isolation would require auth (anonymous sign-in + request.auth.uid).
    //   - Room capability isolation: Listing all rooms is strictly forbidden (`allow list: if false`)
    //     to prevent room scraping/enumeration. Users can only access a room if they have its ID.
    //     Listing tasks inside a room is forbidden too: the app only fetches known documents.
    //   - Strict schema validation: Only recognized fields can be written; field types,
    //     ranges, and lengths are strictly enforced on both create and update. The
    //     `*_eval` maps are validated because the client renders their values.
    //   - Updates cannot remove fields that already exist (`removedKeys()`), so a `set()`
    //     without merge can no longer wipe the other user's draft. Values can still be
    //     overwritten by anyone holding the room id.
    //   - Deletions are forbidden (`allow delete: if false`) to prevent accidental or malicious data loss.
    //   - Default deny at root blocks access to any undefined collection or path.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Validate roomId format: alphanumeric, dashes, underscores (1 to 64 chars)
    function isValidRoomId(roomId) {
      return roomId is string &&
             roomId.size() >= 1 &&
             roomId.size() <= 64 &&
             roomId.matches('^[a-zA-Z0-9_-]+$');
    }

    // Validate taskId format: alphanumeric, dashes, underscores (1 to 64 chars)
    function isValidTaskId(taskId) {
      return taskId is string &&
             taskId.size() >= 1 &&
             taskId.size() <= 64 &&
             taskId.matches('^[a-zA-Z0-9_-]+$');
    }

    // Validate timestamp or millisecond epoch integer (>= 0)
    function isValidTimestampOrMillis(val) {
      return (val is int && val >= 0) || val is timestamp;
    }

    // Validate that document contains only recognized fields
    function hasOnlyAllowedSchreibenFields(data) {
      return data.keys().hasOnly([
        'sergio_text',
        'sergio_words',
        'sergio_eval',
        'sergio_updated_at',
        'diana_text',
        'diana_words',
        'diana_eval',
        'diana_updated_at'
      ]);
    }

    // Validate the evaluation report: the client interpolates these values into the
    // interface, so types and ranges matter (score_total must be an integer).
    function isValidEvalMap(m) {
      return m == null || (
        m is map &&
        m.keys().size() <= 50 &&
        (!('verdict' in m) || (m.verdict is string && m.verdict in ['BESTANDEN', 'NICHT BESTANDEN'])) &&
        (!('score_total' in m) || (m.score_total is int && m.score_total >= 0 && m.score_total <= 100)) &&
        (!('word_count' in m) || (m.word_count is int && m.word_count >= 0 && m.word_count <= 5000)) &&
        (!('student_text' in m) || (m.student_text is string && m.student_text.size() <= 10000)) &&
        (!('corrected_version' in m) || (m.corrected_version is string && m.corrected_version.size() <= 10000)) &&
        (!('musterloesung' in m) || (m.musterloesung is string && m.musterloesung.size() <= 10000))
      );
    }

    // ===============================================================
    // Domain Validator (Validator Function Pattern)
    // Enforced in BOTH create and update operations
    // ===============================================================
    function isValidSchreibenDoc(data) {
      return hasOnlyAllowedSchreibenFields(data) &&
             // Sergio fields validation
             (!('sergio_text' in data) || (data.sergio_text is string && data.sergio_text.size() <= 10000)) &&
             (!('sergio_words' in data) || (data.sergio_words is int && data.sergio_words >= 0 && data.sergio_words <= 2000)) &&
             (!('sergio_eval' in data) || isValidEvalMap(data.sergio_eval)) &&
             (!('sergio_updated_at' in data) || data.sergio_updated_at == null || isValidTimestampOrMillis(data.sergio_updated_at)) &&
             // Diana fields validation
             (!('diana_text' in data) || (data.diana_text is string && data.diana_text.size() <= 10000)) &&
             (!('diana_words' in data) || (data.diana_words is int && data.diana_words >= 0 && data.diana_words <= 2000)) &&
             (!('diana_eval' in data) || isValidEvalMap(data.diana_eval)) &&
             (!('diana_updated_at' in data) || data.diana_updated_at == null || isValidTimestampOrMillis(data.diana_updated_at));
    }

    // Root default deny: deny all collections and subcollections by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Rooms collection
    match /rooms/{roomId} {
      // Allow single room document read if roomId is valid
      // Deny listing all rooms (prevents scraping/enumerating active rooms)
      allow get: if isValidRoomId(roomId);
      allow list: if false;

      // Allow room document initialization or heartbeat if matching strict metadata schema
      allow create, update: if isValidRoomId(roomId) &&
                              request.resource.data.keys().hasOnly(['created_at', 'updated_at']) &&
                              (!('created_at' in request.resource.data) || isValidTimestampOrMillis(request.resource.data.created_at)) &&
                              (!('updated_at' in request.resource.data) || isValidTimestampOrMillis(request.resource.data.updated_at));
      allow delete: if false;

      // Schreiben tasks subcollection
      match /schreiben/{taskId} {
        // Allow single task fetch if both roomId and taskId are valid
        allow get: if isValidRoomId(roomId) && isValidTaskId(taskId);

        // Listing tasks is forbidden: the app always fetches a known document id.
        allow list: if false;

        // Allow task creation with strict schema validation
        allow create: if isValidRoomId(roomId) &&
                        isValidTaskId(taskId) &&
                        isValidSchreibenDoc(request.resource.data);

        // Allow task update with strict schema validation, but never removing fields
        // that already exist: un `set()` sin merge no puede vaciar el documento.
        allow update: if isValidRoomId(roomId) &&
                        isValidTaskId(taskId) &&
                        isValidSchreibenDoc(request.resource.data) &&
                        request.resource.data.diff(resource.data).removedKeys().size() == 0;

        // Forbid deletion to prevent accidental or malicious data loss
        allow delete: if false;
      }
    }
  }
}
